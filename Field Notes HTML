<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" href="https://field.syncfirstessentials.com/sfe-favicon-high-532x532.png">

    <title>FIELD Notes</title>


    <style>
        @import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Barlow:wght@300;400;600;700&display=swap');

        :root {
            --bg: #0d0f14;
            --bg2: #13161e;
            --bg3: #1a1e28;
            --border: #2a2f3d;
            --accent: #00e5ff;
            --accent2: #7b61ff;
            --accent3: #ff6b35;
            --text: #c8d0e0;
            --text-dim: #6b7590;
            --green: #39ff14;
            --yellow: #ffd600;
            --red: #ff4444;
            --code-bg: #0a0c10;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: var(--bg);
            color: var(--text);
            font-family: 'Barlow', sans-serif;
            font-size: 15px;
            line-height: 1.6;
            background-attachment: fixed;
        }

        /* HEADER */
        header {
            background: linear-gradient(135deg, #0d0f14 0%, #1a1e28 50%, #0d0f14 100%);
            border-bottom: 1px solid var(--accent);
            padding: 28px 40px 20px 60px;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 4px 30px rgba(0,229,255,0.08);
        }

        header h1 {
            font-family: 'Share Tech Mono', monospace;
            font-size: 1.5rem;
            color: var(--accent);
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        header p {
            color: var(--text-dim);
            font-size: 0.8rem;
            margin-top: 2px;
            font-family: 'Share Tech Mono', monospace;
        }

        .header-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            flex-wrap: wrap;
            gap: 12px;
        }

        /* SEARCH */
        .search-wrap {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        #search {
            background: var(--code-bg);
            border: 1px solid var(--border);
            border-radius: 4px;
            color: var(--text);
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.85rem;
            padding: 6px 14px;
            width: 240px;
            outline: none;
            transition: border-color 0.2s;
        }

        #search:focus { border-color: var(--accent); }
        #search::placeholder { color: var(--text-dim); }

        .search-count {
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.75rem;
            color: var(--text-dim);
            min-width: 60px;
        }

        /* LAYOUT */
        .container {
            display: flex;
            max-width: 1400px;
            margin: 0 auto;
        }

        /* SIDEBAR NAV */
        nav {
            width: 220px;
            min-width: 220px;
            padding: 24px 0;
            position: sticky;
            top: 80px;
            height: calc(100vh - 80px);
            overflow-y: auto;
            border-right: 1px solid var(--border);
        }

        nav a {
            display: block;
            padding: 7px 24px;
            color: var(--text-dim);
            text-decoration: none;
            font-size: 0.82rem;
            font-family: 'Share Tech Mono', monospace;
            border-left: 2px solid transparent;
            transition: all 0.15s;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        nav a:hover, nav a.active {
            color: var(--accent);
            border-left-color: var(--accent);
            background: rgba(0,229,255,0.04);
        }

        nav .nav-label {
            padding: 16px 24px 4px;
            font-size: 0.65rem;
            letter-spacing: 2px;
            color: var(--text-dim);
            text-transform: uppercase;
            font-family: 'Barlow', sans-serif;
            font-weight: 600;
        }

        /* HAMBURGER MENU — SITE-WIDE NAV */
        .hamburger {
            position: fixed;
            top: 18px;
            left: 16px;
            z-index: 200;
            background: var(--bg3);
            border: 1px solid var(--border);
            border-radius: 4px;
            color: var(--accent);
            cursor: pointer;
            padding: 6px 10px;
            font-size: 1.3rem;
            line-height: 1;
            transition: all 0.15s;
        }

        .hamburger:hover {
            border-color: var(--accent);
            box-shadow: 0 0 10px rgba(0,229,255,0.2);
        }

        .site-nav-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.7);
            z-index: 150;
        }

        .site-nav-overlay.open { display: block; }

        .site-nav {
            position: fixed;
            top: 0;
            left: -280px;
            width: 280px;
            height: 100%;
            background: var(--bg2);
            border-right: 1px solid var(--accent);
            z-index: 201;
            padding: 70px 0 20px;
            overflow-y: auto;
            transition: left 0.25s ease;
        }

        .site-nav.open { left: 0; }

        .site-nav .nav-label {
            padding: 16px 24px 4px;
            font-size: 0.65rem;
            letter-spacing: 2px;
            color: var(--text-dim);
            text-transform: uppercase;
            font-family: 'Barlow', sans-serif;
            font-weight: 600;
        }

        .site-nav a {
            display: block;
            padding: 10px 24px;
            color: var(--text-dim);
            text-decoration: none;
            font-size: 0.85rem;
            font-family: 'Share Tech Mono', monospace;
            border-left: 2px solid transparent;
            transition: all 0.15s;
        }

        .site-nav a:hover {
            color: var(--accent);
            border-left-color: var(--accent);
            background: rgba(0,229,255,0.04);
        }

        .site-nav a.current {
            color: var(--accent);
            border-left-color: var(--accent);
        }


        /* MAIN CONTENT */
        main {
            flex: 1;
            padding: 32px 40px;
            min-width: 0;
        }

        /* SECTIONS */
        .section {
            scroll-margin-top: 100px;
            margin-bottom: 48px;
            border: 1px solid var(--border);
            border-radius: 6px;
            overflow: hidden;
            transition: border-color 0.2s;
        }

        .section:hover { border-color: rgba(0,229,255,0.25); }

        .section-header {
            background: var(--bg3);
            padding: 14px 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
            user-select: none;
        }

        .section-header h2 {
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.95rem;
            color: var(--accent);
            letter-spacing: 1px;
            flex: 1;
        }

        .section-icon {
            font-size: 1.1rem;
            width: 28px;
            text-align: center;
        }

        .toggle-btn {
            background: none;
            border: none;
            color: var(--text-dim);
            cursor: pointer;
            font-size: 0.8rem;
            font-family: 'Share Tech Mono', monospace;
            padding: 2px 8px;
            border: 1px solid var(--border);
            border-radius: 3px;
            transition: all 0.15s;
        }

        .toggle-btn:hover { border-color: var(--accent); color: var(--accent); }

        .section-body { padding: 20px; }

        /* COMMAND BLOCKS */
        .cmd-block {
            margin-bottom: 20px;
        }

        .cmd-block:last-child { margin-bottom: 0; }

        .cmd-label {
            font-size: 0.72rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--text-dim);
            font-weight: 600;
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .cmd-label::after {
            content: '';
            flex: 1;
            height: 1px;
            background: var(--border);
        }

        .badge {
            font-size: 0.65rem;
            padding: 1px 7px;
            border-radius: 3px;
            font-weight: 700;
            letter-spacing: 1px;
        }

        .badge-ps { background: rgba(123,97,255,0.2); color: var(--accent2); border: 1px solid rgba(123,97,255,0.3); }
        .badge-cmd { background: rgba(255,107,53,0.2); color: var(--accent3); border: 1px solid rgba(255,107,53,0.3); }
        .badge-reg { background: rgba(0,229,255,0.1); color: var(--accent); border: 1px solid rgba(0,229,255,0.2); }
        .badge-warn { background: rgba(255,214,0,0.1); color: var(--yellow); border: 1px solid rgba(255,214,0,0.2); }

        pre {
            background: var(--code-bg);
            border: 1px solid var(--border);
            border-radius: 4px;
            padding: 14px 16px;
            overflow-x: auto;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.82rem;
            line-height: 1.7;
            position: relative;
        }

        pre:hover .copy-btn { opacity: 1; }

        .copy-btn {
            position: absolute;
            top: 8px;
            right: 8px;
            background: var(--bg3);
            border: 1px solid var(--border);
            color: var(--text-dim);
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.7rem;
            padding: 3px 10px;
            border-radius: 3px;
            cursor: pointer;
            opacity: 0;
            transition: all 0.15s;
        }

        .copy-btn:hover { color: var(--accent); border-color: var(--accent); }
        .copy-btn.copied { color: var(--green); border-color: var(--green); opacity: 1; }

        .comment { color: #4a5568; }
        .cmd-text { color: #a8d8a8; }
        .flag { color: #87ceeb; }
        .path { color: #ffd700; }
        .string { color: #ffa07a; }

        /* TABLE */
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.83rem;
            font-family: 'Share Tech Mono', monospace;
        }

        th {
            background: var(--bg3);
            color: var(--accent);
            padding: 8px 14px;
            text-align: left;
            font-size: 0.75rem;
            letter-spacing: 1px;
            border-bottom: 1px solid var(--border);
        }

        td {
            padding: 7px 14px;
            border-bottom: 1px solid var(--border);
            color: var(--text);
            vertical-align: top;
        }

        tr:last-child td { border-bottom: none; }
        tr:hover td { background: rgba(255,255,255,0.02); }

        td:first-child { color: var(--accent2); white-space: nowrap; }

        /* WARN BOX */
        .warn-box {
            background: rgba(255,214,0,0.05);
            border: 1px solid rgba(255,214,0,0.2);
            border-radius: 4px;
            padding: 10px 14px;
            font-size: 0.82rem;
            color: var(--yellow);
            margin-bottom: 14px;
            font-family: 'Share Tech Mono', monospace;
        }

        .warn-box::before { content: '⚠ '; }

        /* HIGHLIGHT for search */
        mark {
            background: rgba(0,229,255,0.25);
            color: var(--accent);
            border-radius: 2px;
            padding: 0 1px;
        }

        .hidden { display: none !important; }

        /* FOOTER */
        footer {
            border-top: 1px solid var(--border);
            padding: 16px 40px;
            color: var(--text-dim);
            font-size: 0.75rem;
            font-family: 'Share Tech Mono', monospace;
            text-align: center;
        }

        /* SCROLLBAR */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: var(--bg); }
        ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--accent2); }

        @media (max-width: 800px) {
            nav { display: none; }
            main { padding: 20px; }
            header { padding: 16px 20px; }
            .header-row { flex-direction: column; align-items: flex-start; }
            #search { width: 100%; }
        }
    </style>
</head>
