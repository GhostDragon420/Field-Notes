<script>
    // Toggle sections
    function toggleSection(header) {
        const body = header.nextElementSibling;
        const btn = header.querySelector('.toggle-btn');
        const isHidden = body.style.display === 'none';
        body.style.display = isHidden ? 'block' : 'none';
        btn.textContent = isHidden ? '▼' : '▶';
    }

    // Copy button
    function copyCode(btn) {
        const pre = btn.parentElement;
        const text = pre.innerText.replace('copy', '').replace('copied', '').trim();
        navigator.clipboard.writeText(text).then(() => {
            btn.textContent = 'copied';
            btn.classList.add('copied');
            setTimeout(() => {
                btn.textContent = 'copy';
                btn.classList.remove('copied');
            }, 1800);
        });
    }

    // Add copy buttons to all pre-elements
    document.querySelectorAll('pre').forEach(pre => {
        if (!pre.querySelector('.copy-btn')) {
            const btn = document.createElement('button');
            btn.className = 'copy-btn';
            btn.textContent = 'copy';
            btn.onclick = function() { copyCode(this); };
            pre.insertBefore(btn, pre.firstChild);
        }
    });

    // Search
    const searchInput = document.getElementById('search');
    const searchCount = document.getElementById('search-count');

    searchInput.addEventListener('input', function() {
        const query = this.value.toLowerCase().trim();

        if (!query) {
            // Reset all
            document.querySelectorAll('.section').forEach(s => s.classList.remove('hidden'));
            document.querySelectorAll('.cmd-block').forEach(b => b.classList.remove('hidden'));
            searchCount.textContent = '';
            // Remove highlights
            document.querySelectorAll('mark').forEach(m => {
                m.replaceWith(m.textContent);
            });
            return;
        }

        let matchCount = 0;

        document.querySelectorAll('.section').forEach(section => {
            const sectionText = section.innerText.toLowerCase();
            if (sectionText.includes(query)) {
                section.classList.remove('hidden');
                // Make sure body is visible
                const body = section.querySelector('.section-body');
                if (body) body.style.display = 'block';
                const btn = section.querySelector('.toggle-btn');
                if (btn) btn.textContent = '▼';
                matchCount++;
            } else {
                section.classList.add('hidden');
            }
        });

        searchCount.textContent = matchCount > 0 ? matchCount + ' sections' : 'no match';
    });

    // Active nav highlight on scroll
    const sections = document.querySelectorAll('.section');
    const navLinks = document.querySelectorAll('nav a');

    window.addEventListener('scroll', () => {
        let current = '';
        sections.forEach(section => {
            if (section.offsetTop <= window.scrollY + 120) {
                current = section.id;
            }
        });
        navLinks.forEach(link => {
            link.classList.remove('active');
            if (link.getAttribute('href') === '#' + current) {
                link.classList.add('active');
            }
        });
    });
    // Site-wide nav toggle
    function toggleSiteNav() {
        document.getElementById('siteNav').classList.toggle('open');
        document.getElementById('siteNavOverlay').classList.toggle('open');
    }
</script>
